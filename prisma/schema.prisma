// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. USERS
model User {
  id        String   @id @default(cuid())
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedShops Shop[]     @relation("OwnerShop")
  shopUsers  ShopUser[]

  @@map("users")
}

// 2. ROLES
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now())

  // Relations
  shopUsers ShopUser[]
}

// 3. SHOPS
model Shop {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?
  currency    String   @db.VarChar(10)
  status      String   @default("active") @db.VarChar(20)
  ownerId     String
  createdAt   DateTime @default(now())

  // Relations
  owner      User       @relation("OwnerShop", fields: [ownerId], references: [id])
  shopUsers  ShopUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
}

// 4. SHOP_USERS
model ShopUser {
  id         Int      @id @default(autoincrement())
  userId     String
  shopId     Int
  roleId     Int
  assignedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, shopId])
}

// 5. CATEGORIES
model Category {
  id          Int     @id @default(autoincrement())
  shopId      Int
  name        String  @db.VarChar(100)
  description String?

  // Relations
  shop              Shop              @relation(fields: [shopId], references: [id])
  productCategories ProductCategory[]
}

// 6. PRODUCTS
model Product {
  id          Int      @id @default(autoincrement())
  shopId      Int
  name        String   @db.VarChar(150)
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())

  // Relations
  shop              Shop              @relation(fields: [shopId], references: [id])
  productVariants   ProductVariant[]
  productCategories ProductCategory[]
  orderDetails      OrderDetail[]
}

// 7. PRODUCT_CATEGORIES
model ProductCategory {
  id         Int @id @default(autoincrement())
  productId  Int
  categoryId Int

  // Relations
  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([productId, categoryId])
}

// 8. PRODUCT_VARIANTS
model ProductVariant {
  id           Int      @id @default(autoincrement())
  productId    Int
  sku          String   @unique @db.VarChar(100)
  specialPrice Decimal? @db.Decimal(10, 2)
  attributes   Json
  status       String   @default("active") @db.VarChar(20)

  // Relations
  product      Product       @relation(fields: [productId], references: [id])
  inventory    Inventory?
  orderDetails OrderDetail[]
}

// 9. INVENTORY
model Inventory {
  id            Int      @id @default(autoincrement())
  variantId     Int      @unique
  quantity      Int      @default(0)
  minStockAlert Int      @default(0)
  updatedAt     DateTime @default(now())

  // Relations
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

// 10. ORDERS
model Order {
  id           Int      @id @default(autoincrement())
  shopId       Int
  customerName String   @db.VarChar(150)
  status       String   @default("pending") @db.VarChar(30)
  total        Decimal  @db.Decimal(12, 2)
  currency     String   @db.VarChar(10)
  createdAt    DateTime @default(now())

  // Relations
  shop         Shop          @relation(fields: [shopId], references: [id])
  orderDetails OrderDetail[]
  payments     Payment?
}

// 11. ORDER_DETAILS
model OrderDetail {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  // Relations
  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

// 12. PAYMENTS
model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  paymentMethod   String    @db.VarChar(50)
  paymentProvider String?   @db.VarChar(50)
  status          String    @default("pending") @db.VarChar(30)
  amount          Decimal   @db.Decimal(12, 2)
  paymentDate     DateTime?

  // Relations
  order Order @relation(fields: [orderId], references: [id])
}
